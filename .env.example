# MongoDB Atlas Connection String (leave blank for local persistent fallback during preview)
MONGODB_URI=

# JWT Signing Secret (server generates an ephemeral fallback if unset; set a strong secret in production)
JWT_SECRET=

# Server Port
PORT=3000

# Allowed Client Origin for CORS in production
CLIENT_URL=

# Environment (development | production)
NODE_ENV=development

# GEMINI_API_KEY: Optional server-side Gemini key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Application URL
APP_URL="MY_APP_URL"
